{
  "name": "moonlight-frontend",
  "private": true,
  "version": "2026.725.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dist:win": "vite build && node ./node_modules/electron-packager/bin/electron-packager.js . Moonlight --platform=win32 --arch=x64 --out=dist-electron --overwrite --prune=false --icon=electron/icon.ico && node ./electron/build-icon.js",
    "dist:linux": "vite build && node ./node_modules/electron-packager/bin/electron-packager.js . Moonlight --platform=linux --arch=x64 --out=dist-electron --overwrite --prune=false"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-context-menu": "^2.3.1",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.1.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "socket.io-client": "^4.8.0",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^31.3.1",
    "electron-packager": "^17.1.2",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.4.45",
    "rcedit": "^5.0.2",
    "tailwindcss": "^3.4.10",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^5.4.3"
  }
}

const SECTION_COMPONENTS = {
  cuenta: CuentaInfo,
  privacidad: Privacidad,
  notificaciones: Notificaciones,
  apariencia: Apariencia,
  accesibilidad: Accesibilidad,
  voz: VozVideo,

          <DialogTitle className="text-sm font-bold uppercase tracking-wider text-muted-foreground">
            Color del avatar
          </DialogTitle>
          <p className="text-xs text-muted-foreground mt-1">
            Selecciona un color de fondo para tu avatar predeterminado.
          </p>
        </DialogHeader>
 

# Base de datos: SQLite para desarrollo (un solo archivo en disco)
DATABASE_URL="file:./dev.db"

# Para PostgreSQL en producción, reemplaza por algo como:
# DATABASE_URL="postgresql://usuario:password@localhost:5432/minidiscord"

# Puerto del servidor backend
PORT=4000

# Secreto para firmar JWT (cámbialo en producción)
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Origen permitido para CORS (la URL del frontend)
CLIENT_URL="http://localhost:5173"
